### artificial example of the effect of the band-pass filter
### on the spectrum

include cffilt.gfn
nulldata 256

set seed 260593

setobs 1 1 --special
y = filter(normal(), 1, {1.8, -0.9})
flt = cffilt(y, 12, 60)
dif = y - flt

if $version < 20240
    pergm y   --plot=display
    pergm flt --plot=display
    pergm dif --plot=display
else
    # use features in gretl 2024a to produce a combined plot
    gpbuild spectra
        pergm y --silent
        pergm flt --silent
        pergm dif --silent
    end gpbuild

    gridplot spectra --rows=1 --width=1200 --output=display
endif
