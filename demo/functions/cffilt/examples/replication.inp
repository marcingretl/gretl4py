# Replicate Christiano and Fitzgerald (2003) "The Band Pass Filter",
# International Economic Review,
# Figure 5, page 453

clear
include cffilt.gfn

open fedstl.bin
data m2ns cpiaucns

series m2g = 100 * sdiff(log(m2ns))
series infl = 100 * sdiff(log(cpiaucns))
list X = m2g infl
smpl 1960:1 1997:12

setopt plot persist --time-series --with-lines

gpbuild CFRepli
    plot X
        literal set title 'M2 Growth and Inflation'
    end plot

    list B = cffilt_list(X, 18, 96, 0, 0)
    plot B
        literal set title 'Component, 1.5-8 years'
        literal set key off
    end plot

    list C = cffilt_list(X, 96, 240)
    plot C
        literal set title 'Component, 8-20 years'
        literal set key off
    end plot

    list D = cffilt_list(X, 240, 480)
    plot D
        literal set title 'Component, 20-40 years'
        literal set key off
    end plot
end gpbuild

gridplot CFRepli --output=display
