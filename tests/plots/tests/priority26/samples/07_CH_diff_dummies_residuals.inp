# Canova_Hansen: first differences with seasonal dummies and linear trend.
# Display residuals from the actual auxiliary regression stored in the bundle.
open data9-9.gdt --quiet
list X_list = null
bundle CH = Canova_Hansen(nocars, 1, 0, 1, 0, X_list, 0)
CH_test_bundle_plot(&CH, 0)
series ch_resid = CH["uhat"]
gnuplot ch_resid --time-series --with-lines --output=display
