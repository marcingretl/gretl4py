# Canova_Hansen: differences, trigonometric seasonal terms and lagged dependent series.
# Plot the actual differenced data and fitted auxiliary-regression series.
open data9-9.gdt --quiet
list X_list = null
bundle CH = Canova_Hansen(nocars, 1, 1, 2, 0, X_list, 0)
CH_test_bundle_plot(&CH, 1)
series ch_fitted = CH["yhat"]
series ch_actual = diff(nocars)
gnuplot ch_actual ch_fitted --time-series --with-lines --output=display
