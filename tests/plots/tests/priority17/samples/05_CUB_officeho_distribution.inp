# CUB: use the official ordinal survey data shipped with the package.
# The original example's univer.gdt file is required by --frompkg=CUB.
set seed 20261118
open univer.gdt --frompkg=CUB --quiet
# Baseline no-covariate CUB(0,0) distribution against observed frequencies.
bundle mod = CUB_setup(officeho)
CUB_estimate(&mod)
# The plot function is void; do not assign its result.
CUB_dplot(mod)
