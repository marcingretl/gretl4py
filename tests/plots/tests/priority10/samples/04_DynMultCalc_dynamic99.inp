# DynMultCalc: ordinary multiplier plot with a nondefault 99% confidence band.
# Short horizon checks the plotting options against a different matrix length.
set seed 20261118
nulldata 180
setobs 4 1980:1 --time-series
series x = normal()
series y = 1 + 0.45*x + 0.22*x(-1) + 0.13*x(-2) + 0.25*normal()
ols y const y(-1 to -2) x(0 to -2) --quiet
bundle m = multipliers($model, "x", 12)
multi_plot(m, 0, 0.99)
