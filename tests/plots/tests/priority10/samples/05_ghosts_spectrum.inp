# ghosts: log-scaled power spectrum of a synthetic seasonal signal.
# This exercises the package's own spplot() path and frequency-axis labels.
set seed 20261118
nulldata 192
setobs 12 2000:01 --time-series
series e1 = normal()
series e2 = normal()
series y1 = sin(2*$pi*index/12) + 0.4*e1
series y2 = 0.65*sin(2*$pi*(index-2)/12) + 0.25*e1 + 0.55*e2
list Y = y1 y2
bundle s = mvspec(Y, {7,7}, 0.10, 1)
spplot(s, 1, 1)
