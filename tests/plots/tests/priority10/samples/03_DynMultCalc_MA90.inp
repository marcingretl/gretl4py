# DynMultCalc: MA representation of the estimated autoregressive polynomial.
# Naming the dependent variable selects responses to a unit innovation.
set seed 20261118
nulldata 180
setobs 4 1980:1 --time-series
series x = normal()
series y = 1 + 0.45*x + 0.22*x(-1) + 0.13*x(-2) + 0.25*normal()
ols y const y(-1 to -2) x(0 to -2) --quiet
bundle m = multipliers($model, "y", 24)
multi_plot(m, 0, 0.90)
