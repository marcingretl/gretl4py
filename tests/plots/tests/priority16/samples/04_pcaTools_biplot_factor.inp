# pcaTools: reproducible correlated synthetic observations.
# We use an ordinary non-sparse PCA here to focus on drawing paths.
set seed 20261118
nulldata 160
genr time
series a = normal()
series b = 0.7*a + 0.8*normal()
series c = -0.4*a + 0.3*b + 0.7*normal()
list X = a b c
# A discrete factor differentiates the groups in the biplot.
series group = (time > 80)
bundle pc = pcaEst(X, _(do_stdize=1, use_vcv=0))
pc.n_pcs_to_plot = 2
pc.factor = group
pc.color_arrow = "web-blue"
pc.pointsize = 0.8
pcaBiplot(pc)
