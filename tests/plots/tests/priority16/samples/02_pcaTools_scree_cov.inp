# pcaTools: reproducible correlated synthetic observations.
# We use an ordinary non-sparse PCA here to focus on drawing paths.
set seed 20261118
nulldata 160
genr time
series a = normal()
series b = 0.7*a + 0.8*normal()
series c = -0.4*a + 0.3*b + 0.7*normal()
list X = a b c
# Covariance PCA with an adjusted scree-plot font size.
bundle pc = pcaEst(X, _(do_stdize=0, use_vcv=1))
pc.fontsize = 12
pcaScreeplot(pc)
