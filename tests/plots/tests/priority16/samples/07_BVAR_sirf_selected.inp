# BVAR: stable two-variable synthetic quarterly workfile.
# Short posterior simulations are smoke tests, not reliable inference.
set seed 20261118
nulldata 160
setobs 4 1980:1 --time-series
series a = normal()
series b = 0.35*a + normal()
list Y = a b
bundle mod = BVAR_setup(Y, 1, "diff")
# Cholesky-identified response of variable b to a shock in a.
bundle post = BVAR_posterior(mod, "irf", _(iter=399, irf_h=10, mpi_np=1))
list SHOCK = a
list RESPONSE = b
BVAR_irf_plot(post, SHOCK, RESPONSE, _(grid=0))
