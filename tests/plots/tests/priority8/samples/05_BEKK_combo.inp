# BEKK: public conditional variance/covariance/correlation gridplot.
# Supply a positive-definite synthetic covariance path to avoid a lengthy BFGS fit.
set seed 20261117
nulldata 80
setobs 4 2000:1 --time-series
series y1 = normal()
series y2 = 0.4*y1 + normal()
list Y = y1 y2
bundle b = BEKK_Setup(Y, 0)
series v11 = 1.1 + 0.10*sin(index/7)
series c12 = 0.15*sin(index/9)
series v22 = 0.9 + 0.12*cos(index/8)
# For n=2, the vech columns are (1,1), (2,1), (2,2).
matrix b.ht = {v11, c12, v22}
BEKK_ComboPlot(b)
