# FLS: estimate flexible least squares on the airline log-series.
# The coefficient matrix is converted to series and plotted by native gretl commands.
open bjg.gdt --quiet
genr time
list X = const time
# Filter-only path (no smoothing) to exercise more volatile coefficients.
bundle fit = FLS(lg, X, _(mu=10, smooth=0, metric=0))
matrix B = fit.coeff
list coeffs = mat2list(B, "flsfilter")
scatters coeffs --time-series --output=display
