# thresh_infer: use the actual quarterly Denmark example from the package's sample script.
# Remove missing observations before the Hansen (2000) test/estimation routines.
open denmark.gdt --quiet
series mg = diff(LRM)
list rhs = IBO IDE
smpl --no-missing mg rhs
# Public threshold estimation: homoskedastic LR confidence profile.
# The last argument keeps the package's own plot enabled.
set seed 270103
bundle fit = H_thresh_estim(mg, rhs, IDE, FALSE, 0.90, 0.70, 1, 1)
