# thresh_infer: use the actual quarterly Denmark example from the package's sample script.
# Remove missing observations before the Hansen (2000) test/estimation routines.
open denmark.gdt --quiet
series mg = diff(LRM)
list rhs = IBO IDE
smpl --no-missing mg rhs
# Public threshold estimation: heteroskedastic LR confidence profile.
# nonpar=1 selects the documented quadratic auxiliary-regression estimator.
set seed 270104
bundle fit = H_thresh_estim(mg, rhs, IDE, TRUE, 0.95, 0.80, 1, 1)
