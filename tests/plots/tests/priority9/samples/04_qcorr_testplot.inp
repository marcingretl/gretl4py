# qcorr: Ljung-Box statistic plot and bootstrap critical values.
# This exercises a separate plotting branch from lag_plot.
set seed 20261117
nulldata 180
setobs 4 1980:1 --time-series
series y1 = normal()
series y2 = 0.4*y1 + normal()
list Y = y1 y2
bundle opt = _(maxlag=5, bootstrap=1, iter=29, x_axis={0.25,0.5,0.75}, y_axis={0.25,0.5,0.75})
bundle b = cqgm(Y, opt)
bundle graph = _(x2plot={0.5}, y2plot={0.5}, test2plot="LB", display=1)
cqgm_plot(b, "test_plot", graph)
