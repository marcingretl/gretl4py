# qcorr: lag-by-lag correlation plot and bootstrap confidence bounds.
# Select one quantile pair to avoid emitting a grid of many figures.
set seed 20261117
nulldata 180
setobs 4 1980:1 --time-series
series y1 = normal()
series y2 = 0.4*y1 + normal()
list Y = y1 y2
bundle opt = _(maxlag=5, bootstrap=1, iter=29, x_axis={0.25,0.5,0.75}, y_axis={0.25,0.5,0.75})
bundle b = cqgm(Y, opt)
bundle graph = _(x2plot={0.5}, y2plot={0.5}, display=1)
cqgm_plot(b, "lag_plot", graph)
