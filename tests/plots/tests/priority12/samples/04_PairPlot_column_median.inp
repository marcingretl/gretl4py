# PairPlot: independent synthetic cross-sectional data for an isolated plot.
# The three covariates are correlated but non-collinear.
set seed 20261118
nulldata 96
series x1 = normal()
series x2 = 0.65*x1 + 0.7*normal()
series x3 = -0.4*x1 + 0.8*normal()
list X = x1 x2 x3
# One-column layout and group-specific median centroid marks.
series grp = (x2 > 0)
setinfo grp --discrete
bundle opts = _(type="column", centroid="median", centroid_label=1)
PairPlot(X, grp, opts)
