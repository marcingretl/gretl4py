# BVAR 0.4: posterior histograms for all equations in one grid.
# This deliberately expands the number of panels compared with case 05.
set seed 20261120
nulldata 160
setobs 4 1980:1 --time-series
series a = normal()
series b = 0.35*a + normal()
list Y = a b
bundle mod = BVAR_setup(Y, 1, "diff")
bundle post = BVAR_posterior(mod, "coeff", _(iter=399, summ_only=0, mpi_np=1))
BVAR_post_plot(post, "coeff", Y, _(grid=1, gridfontsize=9))
