# BVAR 0.4: histogram grid for the second equation.
# Retained coefficient draws are mandatory for BVAR_post_plot().
set seed 20261120
nulldata 160
setobs 4 1980:1 --time-series
series a = normal()
series b = 0.35*a + normal()
list Y = a b
list B = b
bundle mod = BVAR_setup(Y, 1, "diff")
bundle post = BVAR_posterior(mod, "coeff", _(iter=399, summ_only=0, mpi_np=1))
BVAR_post_plot(post, "coeff", B, _(grid=1, gridfontsize=12))
