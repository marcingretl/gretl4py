# BVAR 0.4: coefficient histograms without the gridplot collection.
# The runner must count the actual number of Matplotlib figures.
set seed 20261120
nulldata 160
setobs 4 1980:1 --time-series
series a = normal()
series b = 0.35*a + normal()
list Y = a b
list A = a
bundle mod = BVAR_setup(Y, 1, "diff")
bundle post = BVAR_posterior(mod, "coeff", _(iter=399, summ_only=0, mpi_np=1))
BVAR_post_plot(post, "coeff", A, _(grid=0))
