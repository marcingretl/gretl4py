# ADMBP: three-column input to the native irf_plot() function.
# Columns hold a central response, lower bound, and upper bound.
include ADMBP.gfn

open AWM.gdt --quiet
matrix point = {0.70; 0.56; 0.44; 0.32; 0.22; 0.14; 0.08; 0.04}
matrix lo = {0.44; 0.32; 0.21; 0.11; 0.01; -0.05; -0.10; -0.12}
matrix hi = {0.96; 0.80; 0.67; 0.53; 0.43; 0.33; 0.26; 0.20}
matrix m = point ~ lo ~ hi
irf_plot(m, "Multipliers with confidence bounds", "Periods", "Response")
