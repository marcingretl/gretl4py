# ADMBP: negative shock and a confidence band crossing zero.
# Keep all bounds in explicit rows to avoid dependencies on estimation.
include ADMBP.gfn

open AWM.gdt --quiet
matrix point = {-0.85; -0.66; -0.48; -0.33; -0.20; -0.12; -0.05; 0.00}
matrix lo = {-1.12; -0.91; -0.72; -0.55; -0.40; -0.30; -0.22; -0.17}
matrix hi = {-0.58; -0.41; -0.24; -0.11; 0.00; 0.06; 0.12; 0.17}
matrix m = point ~ lo ~ hi
irf_plot(m, "Negative response", "Periods", "Dynamic effect")
