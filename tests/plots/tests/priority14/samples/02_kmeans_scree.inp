# kmeans: separated synthetic clusters with reproducible observations.
# Preserve a full, non-missing data sample for the clustering functions.
set seed 20261118
nulldata 120
genr time
series segment = (time > 40) + (time > 80)
series x1 = normal() + 3*segment
series x2 = normal() - 2*segment
series x3 = 0.5*normal() + 1.5*segment
list X = x1 x2 x3
# Scree / elbow curve exercises repeated clustering and a line plot.
# This diagnostic is exploratory, not a selection of an optimal k.
# This function generates a plot but does not return a matrix.
kmeans_screeplot(X, 6)
