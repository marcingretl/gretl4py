# knn: genuine k-fold cross-validation and native package CV plotting.
# This package depends on extra and CvDataSplitter; install full dependencies.
open denmark.gdt --quiet
list x = LRM IBO IDE
# Use an observed economic series as the continuous regression target.
series y = LRY
smpl --no-missing y x
set seed 290110
matrix neighbors = seq(1, 5)
bundle opts = _(splitters="kfold", kfold_nsplits=5, scoring_regression="rmse")
bundle fit = knn_fit(y, x, neighbors, opts)
knn_plot_cvscores(fit)
