# MAR 1.0: matrix-valued autoregression on the package's official dataset.
# This fixture bypasses the upstream MAR_sample.inp -> MAR_10.inp include.
set seed 20261120
open Datavec.gdt --frompkg=MAR --quiet
# Four 2-element column lists form a 2 x 4 matrix time series.
list S1 = V1 V2
list S2 = V3 V4
list S3 = V5 V6
list S4 = V7 V8
lists X = defarray(S1, S2, S3, S4)
# The public IRF function consumes the estimated model bundle.
bundle bdl
# Estimate with an intercept; method 1 is LSE.
MAR(X, 1, 1, 1, 100, &bdl)
# Omitted fourth argument selects the documented TABLE & PLOT mode.
# LSE; shock on row 1, column 2; generalized impulse response over 8 periods.
MAR_IRFs(1, 2, 8, , &bdl)
