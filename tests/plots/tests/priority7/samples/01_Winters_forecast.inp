# Winters: additive seasonal smoothing with an in-sample forecast holdout.
# The bundle-plot path emits a fitted forecast with confidence bands.
set seed 20261117
nulldata 120
setobs 4 1995:1 --time-series
series y = 40 + 0.12*index + 3.0*sin(2*$pi*index/4) + 0.5*normal()
bundle specs = _(additive=1, ntest=8, verbose=0)
bundle w = Winters(y, specs)
Winters_plot(&w, 1)
