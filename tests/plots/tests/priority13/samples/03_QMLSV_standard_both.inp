# QMLSV: use the canonical Bollerslev-Ghysels returns supplied with gretl.
# The 500-observation subsample follows the package manual's worked example.
open b-g.gdt --quiet
smpl 1475 1974
# Both public graphical branches (volatility and standardized density).
bundle m = qml_sv(Y, 1, 0, 1, 1, 100, 0)
qml_plot(&m, 1, 1)
